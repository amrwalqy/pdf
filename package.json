{
  "name": "alif-pdf-reader",
  "productName": "Alif",
  "author": "Alif",
  "version": "1.2.0",
  "description": "Alif PDF Reader — أليف: قارئ PDF لويندوز مع مكتبة مجلدات وخزنة مشفّرة وأدوات دمج واستخراج وتوقيع.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --test e2e/app.e2e.mjs",
    "check": "npm run typecheck && npm run test",
    "release:report": "node scripts/release-report.mjs",
    "desktop:build": "vite build --mode electron",
    "desktop:start": "electron .",
    "dist:win": "npm run desktop:build && electron-builder --win --x64"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.2.5",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.5",
    "clsx": "2.1.1",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.47.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.64.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sprintf-js": "1.1.3",
    "roarr": "7.21.7",
    "global-agent": "4.1.3",
    "braces": "3.0.3",
    "source-map-js": "1.2.2",
    "esbuild": "0.28.2",
    "launch-editor": "2.14.2",
    "tinypool": "2.2.0"
  }
}
